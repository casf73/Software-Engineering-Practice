{
  "id": "API-16-02",
  "iteration": 4,
  "title": "读取已保存配置",
  "designMethod": "场景法",
  "endpoint": "GET /api/seller/products/{id}/customization",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据02.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "p": "/id"
      },
      "bodyFile": "请求数据03.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}/customization",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/customizable": true
      },
      "bodyFile": "请求数据04.json"
    },
    {
      "method": "GET",
      "path": "/api/seller/products/${p}/customization",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/customizable": true,
        "/artisanName": "木作工坊"
      }
    }
  ],
  "expected": "逐步核对HTTP状态、返回字段与业务结果"
}
