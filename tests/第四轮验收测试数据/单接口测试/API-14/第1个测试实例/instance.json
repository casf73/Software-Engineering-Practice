{
  "id": "API-14-01",
  "iteration": 4,
  "title": "卖家下单后直接取消",
  "designMethod": "状态转换",
  "endpoint": "POST /api/seller/shop-orders/{id}/cancel",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据02.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "p": "/id"
      },
      "bodyFile": "请求数据03.json"
    },
    {
      "method": "PUT",
      "path": "/api/customer/cart/${p}",
      "status": 200,
      "session": "buyer",
      "bodyFile": "请求数据04.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/checkout",
      "status": 201,
      "session": "buyer",
      "capture": {
        "o": "/id"
      },
      "bodyFile": "请求数据05.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/shop-orders/${o}/cancel",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/status": "CANCELLED"
      }
    },
    {
      "method": "GET",
      "path": "/api/public/products/${p}",
      "status": 200,
      "assertions": {
        "/stock": 3,
        "/status": "ON_SALE"
      }
    }
  ],
  "expected": "逐步核对HTTP状态、返回字段与业务结果"
}
