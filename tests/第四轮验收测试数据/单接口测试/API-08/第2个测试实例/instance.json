{
  "id": "API-08-02",
  "iteration": 4,
  "title": "部分结算保留未选",
  "designMethod": "场景法",
  "endpoint": "POST /api/customer/checkout",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据02.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "p": "/id"
      },
      "bodyFile": "请求数据03.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "q": "/id"
      },
      "bodyFile": "请求数据04.json"
    },
    {
      "method": "PUT",
      "path": "/api/customer/cart/${p}",
      "status": 200,
      "session": "buyer",
      "bodyFile": "请求数据05.json"
    },
    {
      "method": "PUT",
      "path": "/api/customer/cart/${q}",
      "status": 200,
      "session": "buyer",
      "bodyFile": "请求数据06.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/checkout",
      "status": 201,
      "session": "buyer",
      "bodyFile": "请求数据07.json"
    },
    {
      "method": "GET",
      "path": "/api/customer/cart",
      "status": 200,
      "session": "buyer",
      "assertions": {
        "/0/productId": "${q}"
      }
    },
    {
      "method": "GET",
      "path": "/api/public/products/${p}",
      "status": 200,
      "assertions": {
        "/stock": 2,
        "/status": "ON_SALE"
      }
    }
  ],
  "expected": "逐步核对HTTP状态、返回字段与业务结果"
}
