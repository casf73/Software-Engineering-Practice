{
  "id": "API-01-03",
  "iteration": 4,
  "title": "客户之间隔离",
  "designMethod": "权限隔离",
  "endpoint": "GET /api/customer/cart",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据02.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "p": "/id"
      },
      "bodyFile": "请求数据03.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "other",
      "bodyFile": "请求数据04.json"
    },
    {
      "method": "PUT",
      "path": "/api/customer/cart/${p}",
      "status": 200,
      "session": "buyer",
      "bodyFile": "请求数据05.json"
    },
    {
      "method": "GET",
      "path": "/api/customer/cart",
      "status": 200,
      "session": "other",
      "assertions": {
        "": []
      }
    }
  ],
  "expected": "逐步核对HTTP状态、返回字段与业务结果"
}
