{
  "id": "API-13-04",
  "iteration": 4,
  "title": "取消后不能恢复",
  "designMethod": "终态约束",
  "endpoint": "PUT /api/seller/shop-orders/{id}/status",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据02.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "p": "/id"
      },
      "bodyFile": "请求数据03.json"
    },
    {
      "method": "PUT",
      "path": "/api/customer/cart/${p}",
      "status": 200,
      "session": "buyer",
      "bodyFile": "请求数据04.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/checkout",
      "status": 201,
      "session": "buyer",
      "capture": {
        "o": "/id"
      },
      "bodyFile": "请求数据05.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/shop-orders/${o}/cancel",
      "status": 200,
      "session": "buyer",
      "assertions": {
        "/status": "CANCELLED"
      }
    },
    {
      "method": "PUT",
      "path": "/api/seller/shop-orders/${o}/status",
      "status": 409,
      "session": "seller",
      "bodyFile": "请求数据07.json"
    }
  ],
  "expected": "逐步核对HTTP状态、返回字段与业务结果"
}
