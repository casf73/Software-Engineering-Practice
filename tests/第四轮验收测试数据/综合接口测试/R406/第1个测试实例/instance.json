{
  "id": "R406-01",
  "iteration": 4,
  "title": "启用定制并保存资料",
  "designMethod": "场景法",
  "endpoint": null,
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据02.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "p": "/id"
      },
      "bodyFile": "请求数据03.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}/customization",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/customizable": true
      },
      "bodyFile": "请求数据04.json"
    },
    {
      "method": "GET",
      "path": "/api/public/products/${p}/customization",
      "status": 200,
      "assertions": {
        "/artisanName": "木作工坊",
        "/artisanBio": "手工打磨，逐件制作。"
      }
    }
  ],
  "expected": "逐步核对HTTP状态、返回字段与业务结果"
}
