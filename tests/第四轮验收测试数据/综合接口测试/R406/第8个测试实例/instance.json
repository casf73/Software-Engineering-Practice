{
  "id": "R406-08",
  "iteration": 4,
  "title": "匠人及设计快照和完整制作时间轴",
  "designMethod": "场景法",
  "endpoint": null,
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据02.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "p": "/id"
      },
      "bodyFile": "请求数据03.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}/customization",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/customizable": true
      },
      "bodyFile": "请求数据04.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/products/${p}/custom-orders",
      "status": 201,
      "session": "buyer",
      "capture": {
        "o": "/id"
      },
      "bodyFile": "请求数据05.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}/customization",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/customizable": true
      },
      "bodyFile": "请求数据06.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/shop-orders/${o}/status",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/status": "CONFIRMED"
      },
      "bodyFile": "请求数据07.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/shop-orders/${o}/status",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/status": "PREPARED"
      },
      "bodyFile": "请求数据08.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/shop-orders/${o}/status",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/status": "SHIPPING"
      },
      "bodyFile": "请求数据09.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/shop-orders/${o}/status",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/status": "COMPLETED"
      },
      "bodyFile": "请求数据10.json"
    },
    {
      "method": "GET",
      "path": "/api/customer/shop-orders",
      "status": 200,
      "session": "buyer",
      "assertions": {
        "/items/0/items/0/artisanName": "木作工坊",
        "/items/0/items/0/design/motif": "leaf",
        "/items/0/timeline/4/status": "COMPLETED"
      }
    }
  ],
  "expected": "逐步核对HTTP状态、返回字段与业务结果"
}
