{
  "id": "R401-01",
  "iteration": 4,
  "title": "勾选两个商品合为一单",
  "designMethod": "场景法",
  "endpoint": null,
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据02.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "p": "/id"
      },
      "bodyFile": "请求数据03.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "q": "/id"
      },
      "bodyFile": "请求数据04.json"
    },
    {
      "method": "PUT",
      "path": "/api/customer/cart/${p}",
      "status": 200,
      "session": "buyer",
      "bodyFile": "请求数据05.json"
    },
    {
      "method": "PUT",
      "path": "/api/customer/cart/${q}",
      "status": 200,
      "session": "buyer",
      "bodyFile": "请求数据06.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/checkout",
      "status": 201,
      "session": "buyer",
      "assertions": {
        "/items/0/quantity": 2,
        "/items/1/productId": "${q}",
        "/total": 52.0
      },
      "bodyFile": "请求数据07.json"
    },
    {
      "method": "GET",
      "path": "/api/customer/shop-orders",
      "status": 200,
      "session": "buyer",
      "assertions": {
        "/total": 1
      }
    }
  ],
  "expected": "逐步核对HTTP状态、返回字段与业务结果"
}
