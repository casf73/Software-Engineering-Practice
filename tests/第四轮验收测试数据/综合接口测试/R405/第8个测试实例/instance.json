{
  "id": "R405-08",
  "iteration": 4,
  "title": "缺货定制不生成订单",
  "designMethod": "状态转换",
  "endpoint": null,
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据02.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "p": "/id"
      },
      "bodyFile": "请求数据03.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}/customization",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/customizable": true
      },
      "bodyFile": "请求数据04.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/products/${p}/custom-orders",
      "status": 409,
      "session": "buyer",
      "bodyFile": "请求数据05.json"
    },
    {
      "method": "GET",
      "path": "/api/customer/shop-orders",
      "status": 200,
      "session": "buyer",
      "assertions": {
        "/total": 0
      }
    }
  ],
  "expected": "逐步核对HTTP状态、返回字段与业务结果"
}
