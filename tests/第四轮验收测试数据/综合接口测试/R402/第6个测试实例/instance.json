{
  "id": "R402-06",
  "iteration": 4,
  "title": "售罄保留原收藏",
  "designMethod": "状态转换",
  "endpoint": null,
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据02.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "p": "/id"
      },
      "bodyFile": "请求数据03.json"
    },
    {
      "method": "PUT",
      "path": "/api/customer/favorites/${p}",
      "status": 204,
      "session": "buyer",
      "bodyFile": "请求数据04.json"
    },
    {
      "method": "PUT",
      "path": "/api/customer/cart/${p}",
      "status": 200,
      "session": "buyer",
      "bodyFile": "请求数据05.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/checkout",
      "status": 201,
      "session": "buyer",
      "capture": {
        "o": "/id"
      },
      "bodyFile": "请求数据06.json"
    },
    {
      "method": "GET",
      "path": "/api/customer/favorites",
      "status": 200,
      "session": "buyer",
      "assertions": {
        "/0/status": "DELISTED",
        "/0/stock": 0
      }
    }
  ],
  "expected": "逐步核对HTTP状态、返回字段与业务结果"
}
