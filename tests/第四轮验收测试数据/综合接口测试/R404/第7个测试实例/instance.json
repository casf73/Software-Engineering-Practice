{
  "id": "R404-07",
  "iteration": 4,
  "title": "完成后卖家不能取消",
  "designMethod": "终态约束",
  "endpoint": null,
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据02.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "p": "/id"
      },
      "bodyFile": "请求数据03.json"
    },
    {
      "method": "PUT",
      "path": "/api/customer/cart/${p}",
      "status": 200,
      "session": "buyer",
      "bodyFile": "请求数据04.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/checkout",
      "status": 201,
      "session": "buyer",
      "capture": {
        "o": "/id"
      },
      "bodyFile": "请求数据05.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/shop-orders/${o}/status",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/status": "CONFIRMED"
      },
      "bodyFile": "请求数据06.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/shop-orders/${o}/status",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/status": "PREPARED"
      },
      "bodyFile": "请求数据07.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/shop-orders/${o}/status",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/status": "SHIPPING"
      },
      "bodyFile": "请求数据08.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/shop-orders/${o}/status",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/status": "COMPLETED"
      },
      "bodyFile": "请求数据09.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/shop-orders/${o}/cancel",
      "status": 409,
      "session": "seller"
    },
    {
      "method": "GET",
      "path": "/api/public/products/${p}",
      "status": 200,
      "assertions": {
        "/stock": 2,
        "/status": "ON_SALE"
      }
    }
  ],
  "expected": "逐步核对HTTP状态、返回字段与业务结果"
}
