{
  "id": "R403-02",
  "iteration": 4,
  "title": "拒绝跳过确认",
  "designMethod": "无效状态转换",
  "endpoint": null,
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据02.json"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "capture": {
        "p": "/id"
      },
      "bodyFile": "请求数据03.json"
    },
    {
      "method": "PUT",
      "path": "/api/customer/cart/${p}",
      "status": 200,
      "session": "buyer",
      "bodyFile": "请求数据04.json"
    },
    {
      "method": "POST",
      "path": "/api/customer/checkout",
      "status": 201,
      "session": "buyer",
      "capture": {
        "o": "/id"
      },
      "bodyFile": "请求数据05.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/shop-orders/${o}/status",
      "status": 409,
      "session": "seller",
      "bodyFile": "请求数据06.json"
    },
    {
      "method": "GET",
      "path": "/api/customer/shop-orders",
      "status": 200,
      "session": "buyer",
      "assertions": {
        "/items/0/status": "PLACED"
      }
    }
  ],
  "expected": "逐步核对HTTP状态、返回字段与业务结果"
}
