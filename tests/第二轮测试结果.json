    {
      "id": "R201-01",
      "caseId": "R201",
      "title": "正常修改并保留排位",
      "mode": "automated",
      "steps": [
        {
          "method": "POST",
          "path": "/api/seller/login",
          "status": 200,
          "saveSession": "seller",
          "bodyFile": "请求数据01.json",
          "assertions": {
            "/authenticated": true
          }
        },
        {
          "method": "POST",
          "path": "/api/seller/products",
          "status": 201,
          "session": "seller",
          "bodyFile": "请求数据02.json",
          "capture": {
            "p": "/id"
          }
        },
        {
          "method": "POST",
          "path": "/api/public/products/${p}/intents",
          "status": 201,
          "bodyFile": "请求数据03.json",
          "assertions": {
            "/position": 1
          },
          "capture": {
            "first": "/passcode"
          }
        },
        {
          "method": "POST",
          "path": "/api/public/products/${p}/intents",
          "status": 201,
          "bodyFile": "请求数据04.json",
          "assertions": {
            "/position": 2
          },
          "capture": {
            "code": "/passcode"
          }
        },
        {
          "method": "PUT",
          "path": "/api/public/intents/${code}",
          "status": 200,
          "bodyFile": "请求数据05.json",
          "assertions": {
            "/name": "更新姓名1",
            "/position": 2
          }
        },
        {
          "method": "PUT",
          "path": "/api/public/intents/${code}",
          "status": 400,
          "bodyFile": "请求数据06.json"
        },
        {
          "method": "DELETE",
          "path": "/api/public/intents/${code}",
          "status": 204
        },
        {
          "method": "GET",
          "path": "/api/public/intents/${code}",
          "status": 404
        }
      ],
      "expected": "全部步骤满足状态码和响应字段断言",
      "result": "通过",
