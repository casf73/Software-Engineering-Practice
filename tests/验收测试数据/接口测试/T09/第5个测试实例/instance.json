        "/authenticated": true
      }
    },
    {
      "method": "UPLOAD",
      "path": "/api/seller/products/image",
      "status": 200,
      "session": "seller",
      "capture": {
        "image": "/url"
      },
      "file": "sample.jpg",
      "mime": "image/jpeg"
    }
  ],
  "expected": "逐步验证 HTTP 状态码及响应字段，详见步骤断言。",
  "result": "通过"
