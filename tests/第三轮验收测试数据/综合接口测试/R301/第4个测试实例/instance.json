{
  "id": "R301-04",
  "caseId": "R301",
  "iteration": 3,
  "type": "综合接口测试",
  "title": "不同商品可同时接单",
  "mode": "automated",
  "designMethod": "场景法",
  "preconditions": "独立内存H2；成功创建购买意向使用有效客户会话，历史访客数据显式预置。",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据02.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据03.json",
      "capture": {
        "other": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "bodyFile": "客户登录前置数据.json",
      "saveSession": "fixtureCustomer",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/public/products/${p}/intents",
      "status": 201,
      "bodyFile": "请求数据04.json",
      "assertions": {
        "/position": 1
      },
      "capture": {
        "code": "/passcode"
      },
      "session": "fixtureCustomer"
    },
    {
      "method": "POST",
      "path": "/api/public/products/${other}/intents",
      "status": 201,
      "bodyFile": "请求数据05.json",
      "assertions": {
        "/position": 1
      },
      "capture": {
        "otherCode": "/passcode"
      },
      "session": "fixtureCustomer"
    },
    {
      "method": "GET",
      "path": "/api/public/products",
      "status": 200,
      "assertions": {
        "/total": 2
      }
    }
  ],
  "expected": "逐步验证 HTTP 状态码及响应字段，详见步骤断言。",
  "result": "通过"
}
