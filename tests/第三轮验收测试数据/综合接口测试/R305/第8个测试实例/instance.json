{
  "id": "R305-08",
  "caseId": "R305",
  "iteration": 3,
  "type": "综合接口测试",
  "title": "富文本编辑二次保存",
  "mode": "automated",
  "designMethod": "等价类划分",
  "preconditions": "独立内存H2；成功创建购买意向使用有效客户会话，历史访客数据显式预置。",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "UPLOAD",
      "path": "/api/seller/products/image",
      "status": 200,
      "session": "seller",
      "capture": {
        "image": "/url"
      },
      "file": "sample.png",
      "mime": "image/png"
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据03.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}",
      "status": 200,
      "session": "seller",
      "bodyFile": "请求数据04.json",
      "assertions": {
        "/description": "<h3>介绍</h3><p><strong>九成新</strong></p>"
      }
    }
  ],
  "expected": "逐步验证 HTTP 状态码及响应字段，详见步骤断言。",
  "result": "通过"
}
