{
  "id": "R307-03",
  "caseId": "R307",
  "iteration": 3,
  "type": "综合接口测试",
  "title": "未登录提交拒绝与历史访客记录隔离",
  "mode": "automated",
  "designMethod": "权限隔离",
  "preconditions": "独立内存H2；成功创建购买意向使用有效客户会话，历史访客数据显式预置。",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据02.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据03.json",
      "assertions": {
        "/authenticated": true,
        "/customer/username": "buyer01",
        "/customer/defaultLocation": "学校南门"
      },
      "capture": {
        "buyerId": "/customer/id"
      },
      "absent": [
        "/customer/passwordHash",
        "/customer/password"
      ]
    },
    {
      "method": "POST",
      "path": "/api/customer/products/${p}/intents",
      "status": 201,
      "session": "buyer",
      "bodyFile": "请求数据04.json",
      "capture": {
        "code": "/passcode"
      }
    },
    {
      "method": "POST",
      "path": "/api/public/products/${p}/intents",
      "status": 401,
      "bodyFile": "请求数据05.json"
    },
    {
      "method": "SEED_LEGACY_INTENT",
      "path": "${p}",
      "bodyFile": "请求数据05.json",
      "description": "预置历史访客记录，不通过匿名接口创建新意向"
    },
    {
      "method": "GET",
      "path": "/api/customer/orders",
      "status": 200,
      "session": "buyer",
      "assertions": {
        "/total": 1
      }
    }
  ],
  "expected": "逐步验证 HTTP 状态码及响应字段，详见步骤断言。",
  "result": "通过"
}
