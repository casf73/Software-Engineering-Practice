{
  "id": "R307-05",
  "caseId": "R307",
  "iteration": 3,
  "type": "接口测试",
  "title": "成功交易历史仍保留",
  "mode": "automated",
  "designMethod": "场景法",
  "preconditions": "独立内存 H2；每个实例前清理测试数据，卖家初始 admin/123456。",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据02.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据03.json",
      "assertions": {
        "/authenticated": true,
        "/customer/username": "buyer01",
        "/customer/defaultLocation": "学校南门"
      },
      "capture": {
        "buyerId": "/customer/id"
      },
      "absent": [
        "/customer/passwordHash",
        "/customer/password"
      ]
    },
    {
      "method": "POST",
      "path": "/api/customer/products/${p}/intents",
      "status": 201,
      "session": "buyer",
      "bodyFile": "请求数据04.json",
      "capture": {
        "code": "/passcode"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products/${p}/trades/start",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/status": "IN_TRADE"
      },
      "capture": {
        "trade": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/trades/${trade}/result",
      "status": 204,
      "session": "seller",
      "bodyFile": "请求数据06.json"
    },
    {
      "method": "GET",
      "path": "/api/customer/orders",
      "status": 200,
      "session": "buyer",
      "assertions": {
        "/items/0/status": "TRADE_SUCCESS",
        "/items/0/passcode": null
      }
    }
  ],
  "expected": "逐步验证 HTTP 状态码及响应字段，详见步骤断言。",
  "result": "通过"
}
