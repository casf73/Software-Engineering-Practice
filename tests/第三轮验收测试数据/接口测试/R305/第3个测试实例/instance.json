{
  "id": "R305-03",
  "caseId": "R305",
  "title": "描述图片二次保存及危险内容清理",
  "mode": "automated",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "UPLOAD",
      "path": "/api/seller/products/image",
      "status": 200,
      "session": "seller",
      "file": "商品图.png",
      "mime": "image/png",
      "capture": {
        "image": "/url"
      }
    },
    {
      "method": "UPLOAD",
      "path": "/api/seller/products/image",
      "status": 200,
      "session": "seller",
      "file": "商品图.jpg",
      "mime": "image/jpeg",
      "capture": {
        "image2": "/url"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据04.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "GET",
      "path": "/api/public/products/${p}",
      "status": 200,
      "assertions": {
        "/description": "<p>安全文字</p><img src=\"${image}\" alt=\"商品描述图片\">alert(1)"
      },
      "capture": {
        "description": "/description"
      }
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}",
      "status": 200,
      "session": "seller",
      "bodyFile": "请求数据06.json",
      "assertions": {
        "/description": "<p>安全文字</p><img src=\"${image}\" alt=\"商品描述图片\">alert(1)"
      }
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}",
      "status": 400,
      "session": "seller",
      "bodyFile": "请求数据07.json"
    }
  ],
  "expected": "全部步骤满足状态码和响应字段断言",
  "iteration": 3,
  "type": "接口测试",
  "designMethod": "场景法",
  "result": "通过"
}
