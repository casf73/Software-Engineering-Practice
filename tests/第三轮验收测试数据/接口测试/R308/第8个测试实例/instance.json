{
  "id": "R308-08",
  "caseId": "R308",
  "iteration": 3,
  "type": "接口测试",
  "title": "客户列表分页边界",
  "mode": "automated",
  "designMethod": "等价类划分",
  "preconditions": "独立内存 H2；每个实例前清理测试数据，卖家初始 admin/123456。",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据02.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/customer/register",
      "status": 201,
      "saveSession": "buyer",
      "bodyFile": "请求数据03.json",
      "assertions": {
        "/authenticated": true,
        "/customer/username": "buyer01",
        "/customer/defaultLocation": "学校南门"
      },
      "capture": {
        "buyerId": "/customer/id"
      },
      "absent": [
        "/customer/passwordHash",
        "/customer/password"
      ]
    },
    {
      "method": "POST",
      "path": "/api/customer/products/${p}/intents",
      "status": 201,
      "session": "buyer",
      "bodyFile": "请求数据04.json",
      "capture": {
        "code": "/passcode"
      }
    },
    {
      "method": "GET",
      "path": "/api/seller/customers?size=0",
      "status": 400,
      "session": "seller"
    },
    {
      "method": "GET",
      "path": "/api/seller/customers?page=1&size=1",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/items": [],
        "/total": 1
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "session": "buyer",
      "saveSession": "combined",
      "bodyFile": "请求数据07.json"
    },
    {
      "method": "GET",
      "path": "/api/customer/session",
      "status": 200,
      "session": "combined",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/logout",
      "status": 204,
      "session": "combined"
    },
    {
      "method": "GET",
      "path": "/api/customer/session",
      "status": 200,
      "session": "combined",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "GET",
      "path": "/api/seller/customers",
      "status": 401,
      "session": "combined"
    }
  ],
  "expected": "逐步验证 HTTP 状态码及响应字段，详见步骤断言。",
  "result": "通过"
}
