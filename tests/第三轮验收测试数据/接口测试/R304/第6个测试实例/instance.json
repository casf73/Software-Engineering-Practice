{
  "id": "R304-06",
  "caseId": "R304",
  "iteration": 3,
  "type": "接口测试",
  "title": "一级分类含二级",
  "mode": "automated",
  "designMethod": "等价类划分",
  "preconditions": "独立内存 H2；每个实例前清理测试数据，卖家初始 admin/123456。",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/categories",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据02.json",
      "capture": {
        "cat": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/categories",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据03.json",
      "capture": {
        "child": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据04.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "GET",
      "path": "/api/public/products?categoryId=${cat}",
      "status": 200,
      "assertions": {
        "/total": 1
      }
    }
  ],
  "expected": "逐步验证 HTTP 状态码及响应字段，详见步骤断言。",
  "result": "通过"
}
