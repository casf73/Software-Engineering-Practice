{
  "id": "R202-08",
  "caseId": "R202",
  "iteration": 2,
  "type": "接口测试",
  "title": "访客无权冻结",
  "mode": "automated",
  "designMethod": "状态转换",
  "preconditions": "独立内存 H2；每个实例前清理测试数据，卖家初始 admin/123456。",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据02.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/public/products/${p}/intents",
      "status": 201,
      "bodyFile": "请求数据03.json",
      "assertions": {
        "/position": 1
      },
      "capture": {
        "code": "/passcode"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products/${p}/freeze",
      "status": 401
    }
  ],
  "expected": "逐步验证 HTTP 状态码及响应字段，详见步骤断言。",
  "result": "通过"
}
