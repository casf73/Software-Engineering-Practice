{
  "id": "R201-02",
  "caseId": "R201",
  "iteration": 2,
  "type": "接口测试",
  "title": "手动冻结中修改",
  "mode": "automated",
  "designMethod": "状态转换",
  "preconditions": "独立内存 H2；每个实例前清理测试数据，卖家初始 admin/123456。",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据02.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/public/products/${p}/intents",
      "status": 201,
      "bodyFile": "请求数据03.json",
      "assertions": {
        "/position": 1
      },
      "capture": {
        "code": "/passcode"
      }
    },
    {
      "method": "POST",
      "path": "/api/public/products/${p}/intents",
      "status": 201,
      "bodyFile": "请求数据04.json",
      "assertions": {
        "/position": 2
      },
      "capture": {
        "second": "/passcode"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products/${p}/freeze",
      "status": 200,
      "session": "seller"
    },
    {
      "method": "PUT",
      "path": "/api/public/intents/${second}",
      "status": 200,
      "bodyFile": "请求数据06.json",
      "assertions": {
        "/name": "更新姓名2",
        "/phone": "13900000002",
        "/position": 2
      }
    },
    {
      "method": "GET",
      "path": "/api/public/intents/${second}",
      "status": 200,
      "assertions": {
        "/name": "更新姓名2",
        "/position": 2
      }
    }
  ],
  "expected": "逐步验证 HTTP 状态码及响应字段，详见步骤断言。",
  "result": "通过"
}
