{
  "id": "R201-03",
  "caseId": "R201",
  "title": "他人交易期间修改",
  "mode": "automated",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据02.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/public/products/${p}/intents",
      "status": 201,
      "bodyFile": "请求数据03.json",
      "assertions": {
        "/position": 1
      },
      "capture": {
        "first": "/passcode"
      }
    },
    {
      "method": "POST",
      "path": "/api/public/products/${p}/intents",
      "status": 201,
      "bodyFile": "请求数据04.json",
      "assertions": {
        "/position": 2
      },
      "capture": {
        "code": "/passcode"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products/${p}/trades/start",
      "status": 200,
      "session": "seller",
      "capture": {
        "trade": "/id"
      }
    },
    {
      "method": "PUT",
      "path": "/api/public/intents/${first}",
      "status": 409,
      "bodyFile": "请求数据06.json"
    },
    {
      "method": "PUT",
      "path": "/api/public/intents/${code}",
      "status": 200,
      "bodyFile": "请求数据07.json",
      "assertions": {
        "/name": "更新姓名3",
        "/position": 1
      }
    },
    {
      "method": "PUT",
      "path": "/api/public/intents/${code}",
      "status": 400,
      "bodyFile": "请求数据08.json"
    },
    {
      "method": "DELETE",
      "path": "/api/public/intents/${code}",
      "status": 204
    },
    {
      "method": "GET",
      "path": "/api/public/intents/${code}",
      "status": 404
    }
  ],
  "expected": "全部步骤满足状态码和响应字段断言"
}