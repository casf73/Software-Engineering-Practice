{
  "id": "R202-03",
  "caseId": "R202",
  "title": "交易冻结不可手动解除",
  "mode": "automated",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据02.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据03.json",
      "capture": {
        "other": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/public/products/${p}/intents",
      "status": 201,
      "bodyFile": "请求数据04.json",
      "assertions": {
        "/position": 1
      },
      "capture": {
        "code": "/passcode"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products/${p}/trades/start",
      "status": 200,
      "session": "seller",
      "capture": {
        "trade": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products/${p}/unfreeze",
      "status": 409,
      "session": "seller"
    },
    {
      "method": "POST",
      "path": "/api/seller/products/${p}/freeze",
      "status": 409,
      "session": "seller"
    }
  ],
  "expected": "全部步骤满足状态码和响应字段断言"
}