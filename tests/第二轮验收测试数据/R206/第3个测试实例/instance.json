{
  "id": "R206-03",
  "caseId": "R206",
  "title": "零库存补货上架与非法库存",
  "mode": "automated",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据02.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "GET",
      "path": "/api/public/products",
      "status": 200,
      "assertions": {
        "/total": 0
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products/${p}/relist",
      "status": 409,
      "session": "seller"
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}",
      "status": 400,
      "session": "seller",
      "bodyFile": "请求数据05.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}",
      "status": 400,
      "session": "seller",
      "bodyFile": "请求数据06.json"
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}",
      "status": 200,
      "session": "seller",
      "bodyFile": "请求数据07.json",
      "assertions": {
        "/status": "DELISTED",
        "/stock": 3
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products/${p}/relist",
      "status": 200,
      "session": "seller",
      "assertions": {
        "/status": "ON_SALE",
        "/stock": 3
      }
    },
    {
      "method": "POST",
      "path": "/api/public/products/${p}/intents",
      "status": 201,
      "bodyFile": "请求数据09.json",
      "assertions": {
        "/position": 1
      },
      "capture": {
        "code": "/passcode"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products/${p}/trades/start",
      "status": 200,
      "session": "seller",
      "capture": {
        "trade": "/id"
      }
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}",
      "status": 409,
      "session": "seller",
      "bodyFile": "请求数据11.json"
    }
  ],
  "expected": "全部步骤满足状态码和响应字段断言"
}