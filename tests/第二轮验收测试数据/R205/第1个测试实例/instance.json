{
  "id": "R205-01",
  "caseId": "R205",
  "title": "分类关联与父类筛选",
  "mode": "automated",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/categories",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据02.json",
      "capture": {
        "root": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/categories",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据03.json",
      "capture": {
        "child": "/id"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据04.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "GET",
      "path": "/api/public/products?categoryId=${root}",
      "status": 200,
      "assertions": {
        "/total": 1,
        "/items/0/categoryName": "键盘"
      }
    },
    {
      "method": "DELETE",
      "path": "/api/seller/categories/${child}",
      "status": 409,
      "session": "seller"
    },
    {
      "method": "DELETE",
      "path": "/api/seller/categories/${root}",
      "status": 409,
      "session": "seller"
    }
  ],
  "expected": "全部步骤满足状态码和响应字段断言"
}