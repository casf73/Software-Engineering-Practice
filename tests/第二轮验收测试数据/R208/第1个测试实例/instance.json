{
  "id": "R208-01",
  "caseId": "R208",
  "title": "两张图片与格式化描述",
  "mode": "automated",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "UPLOAD",
      "path": "/api/seller/products/image",
      "status": 200,
      "session": "seller",
      "file": "商品图.png",
      "mime": "image/png",
      "capture": {
        "image": "/url"
      }
    },
    {
      "method": "UPLOAD",
      "path": "/api/seller/products/image",
      "status": 200,
      "session": "seller",
      "file": "商品图.jpg",
      "mime": "image/jpeg",
      "capture": {
        "image2": "/url"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据04.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "GET",
      "path": "/api/public/products/${p}",
      "status": 200,
      "assertions": {
        "/images": [
          "${image}",
          "${image2}"
        ],
        "/description": "<h3>介绍</h3><p><strong>九成新</strong></p>"
      }
    }
  ],
  "expected": "全部步骤满足状态码和响应字段断言"
}