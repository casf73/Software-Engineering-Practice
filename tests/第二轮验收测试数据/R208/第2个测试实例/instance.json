{
  "id": "R208-02",
  "caseId": "R208",
  "title": "九图边界与错误文件拒绝",
  "mode": "automated",
  "steps": [
    {
      "method": "POST",
      "path": "/api/seller/login",
      "status": 200,
      "saveSession": "seller",
      "bodyFile": "请求数据01.json",
      "assertions": {
        "/authenticated": true
      }
    },
    {
      "method": "UPLOAD",
      "path": "/api/seller/products/image",
      "status": 200,
      "session": "seller",
      "file": "商品图.png",
      "mime": "image/png",
      "capture": {
        "image": "/url"
      }
    },
    {
      "method": "UPLOAD",
      "path": "/api/seller/products/image",
      "status": 200,
      "session": "seller",
      "file": "商品图.jpg",
      "mime": "image/jpeg",
      "capture": {
        "image2": "/url"
      }
    },
    {
      "method": "POST",
      "path": "/api/seller/products",
      "status": 201,
      "session": "seller",
      "bodyFile": "请求数据04.json",
      "capture": {
        "p": "/id"
      }
    },
    {
      "method": "GET",
      "path": "/api/public/products/${p}",
      "status": 200,
      "assertions": {
        "/images": [
          "${image}",
          "${image}",
          "${image}",
          "${image}",
          "${image}",
          "${image}",
          "${image}",
          "${image}",
          "${image}"
        ]
      }
    },
    {
      "method": "PUT",
      "path": "/api/seller/products/${p}",
      "status": 400,
      "session": "seller",
      "bodyFile": "请求数据06.json"
    },
    {
      "method": "UPLOAD",
      "path": "/api/seller/products/image",
      "status": 400,
      "session": "seller",
      "file": "错误格式.txt",
      "mime": "text/plain"
    },
    {
      "method": "UPLOAD",
      "path": "/api/seller/products/image",
      "status": 400,
      "session": "seller",
      "file": "超大图片.png",
      "mime": "image/png"
    }
  ],
  "expected": "全部步骤满足状态码和响应字段断言"
}